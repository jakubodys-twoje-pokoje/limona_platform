# ─── Baza danych ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/limona"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Wygeneruj: openssl rand -base64 32
NEXTAUTH_SECRET="wygeneruj-openssl-rand-base64-32"
NEXTAUTH_URL_DLUZNIK="http://localhost:3000"
NEXTAUTH_URL_INWESTOR="http://localhost:3001"
NEXTAUTH_URL_ADMIN="http://localhost:3002"

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_JEDNORAZOWA="price_..."   # 19.99 PLN – jednorazowy dostęp dla dłużnika
STRIPE_PRICE_MIESIECZNIE="price_..."   # abonament inwestor miesięczny
STRIPE_PRICE_ROCZNIE="price_..."       # abonament inwestor roczny

# ─── Supabase Storage ────────────────────────────────────────────────────────
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_KEY="eyJ..."

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="kontakt@kluczdospokoju.pl"
EMAIL_ADMIN="admin@limona.com.pl"

# ─── Bezpieczeństwo ──────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000    # 15 minut
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5         # max prób logowania per okno
ADMIN_ALLOWED_IPS=""           # opcjonalnie: "1.2.3.4,5.6.7.8"

# ─── Wyszukiwarka kontaktów ──────────────────────────────────────────────────
# Bing Web Search API (Azure Cognitive Services)
BING_SEARCH_API_KEY=""

# Google Custom Search Engine (opcjonalnie, backup)
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_ID=""

# rejestr.io (płatna subskrypcja agregująca CEIDG+KRS)
REJESTR_IO_API_KEY=""

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
ADMIN_EMAIL="admin@limona.com.pl"
